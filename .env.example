# Copy to .env and fill in. .env is gitignored.

# Platforms are configured per league in leagues.yaml. This file holds only
# the credentials, which are per account rather than per league.

# Sleeper needs no auth to read. Set your user id so the bot can tell which
# picks are yours: https://api.sleeper.app/v1/user/<your_username>
SLEEPER_USER_ID=

# FantasyPros rankings. Get a key at https://www.fantasypros.com/api-data/
# (free prototype tier, or a production key with a HOF subscription).
# Without a key, use: draftbot rankings --league <key> --csv <export.csv>
FANTASYPROS_API_KEY=

# Season to pull rankings for.
SEASON=2026

# ESPN (private leagues need these two cookies from your browser session)
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=

# Yahoo. Register an app at https://developer.yahoo.com/apps/create:
#   Application Type   Installed Application
#   Redirect URI       oob
#   API Permissions    Fantasy Sports, Read
# Then run `draftbot auth yahoo` once to store a token in data/yahoo_token.json.
# The token refreshes itself; these two values are the only manual step.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
