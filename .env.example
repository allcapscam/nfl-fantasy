# Copy to .env and fill in. .env is gitignored.

# Platforms are configured per league in leagues.yaml. This file holds only
# the credentials, which are per account rather than per league.

# Sleeper needs no auth to read. Set your user id so the bot can tell which
# picks are yours: https://api.sleeper.app/v1/user/<your_username>
SLEEPER_USER_ID=

# ESPN (private leagues need these two cookies from your browser session)
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=

# Yahoo (OAuth app credentials)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
