# Copy to .env and fill in. .env is gitignored.

# Which adapter to use: sleeper | espn | yahoo | mock
PLATFORM=mock

# Sleeper (no auth needed for public reads; draft id is in the draft URL)
SLEEPER_DRAFT_ID=

# ESPN (private leagues need these two cookies from your browser session)
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=

# Yahoo (OAuth app credentials)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
